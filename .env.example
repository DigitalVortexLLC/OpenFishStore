# ---------------------------------------------------------------------------
# Database (SQLite for local dev; see README for PostgreSQL)
# ---------------------------------------------------------------------------
# connection_limit=1 queues SQLite writes in-process instead of failing on
# database locks. Drop it when using PostgreSQL.
DATABASE_URL="file:./dev.db?connection_limit=1"

# ---------------------------------------------------------------------------
# Staff back office
# ---------------------------------------------------------------------------
# Required: secret used to sign staff session cookies (32+ characters).
# Generate with: openssl rand -base64 32
SESSION_SECRET=""
# Set to "false" only if you serve the app over plain HTTP (e.g. on a LAN).
# Leave unset to detect HTTPS from the request.
COOKIE_SECURE=""
# First owner account created by `npm run db:seed`. If no password is given,
# the seed generates a random one and prints it once.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD=""

# ---------------------------------------------------------------------------
# Store details
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="OpenFishStore"
NEXT_PUBLIC_STORE_TAGLINE="Healthy fish, happy tanks."

# ---------------------------------------------------------------------------
# Shopify (leave blank to run the storefront in demo mode with sample products)
# ---------------------------------------------------------------------------
# e.g. my-fish-store.myshopify.com
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_API_VERSION="2026-07"
# Storefront API public access token (Headless channel or custom app)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
# Admin API access token (custom app) -- used to push inventory changes
SHOPIFY_ADMIN_ACCESS_TOKEN=""
# Location whose inventory the back office adjusts, e.g. gid://shopify/Location/123
SHOPIFY_LOCATION_ID=""
# Webhook signing secret (app client secret) for /api/webhooks/shopify
SHOPIFY_WEBHOOK_SECRET=""
